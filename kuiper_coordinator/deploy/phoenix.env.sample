# Phoenix's settings beside the Rust service's .env (deploy/docker-compose.yml reads both).
# Copy to phoenix.env (git ignores it).
SECRET_KEY_BASE=        # openssl rand -base64 48
KUIPER_ENCRYPTION_KEY=  # openssl rand -base64 32; keep it: forge secrets are encrypted with it
PHX_HOST=kuiper-admin.example.com   # the admin UI's host: GitHub App and webhook URLs use it
